# Copie para .env (chmod 600) e gere segredos novos:
#   python3 -c 'import secrets;print(secrets.token_hex(32))'
POSTGRES_USER=atlas
POSTGRES_DB=atlas
POSTGRES_PASSWORD=troque-por-um-segredo-local
DATABASE_URL=postgresql+psycopg://atlas:troque-por-um-segredo-local@db:5432/atlas

SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=troque-por-32-bytes-hex
API_CACHE_SECRET=troque-por-32-bytes-hex

SEARCH_TIMEOUT_SECONDS=8
SEARCH_CACHE_TTL_SECONDS=600
SEARCH_RATE_LIMIT_PER_MINUTE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
